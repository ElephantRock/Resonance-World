{
  "schema": "resonance-world-autonomous-operating-charter-v0.1",
  "version": "0.1",
  "status": "active_when_human_approved_and_merged_to_main",
  "authority": {
    "issue": 204,
    "parent_program_issue": 111,
    "human_readable_charter": "docs/autonomous-operating-charter-v0.1.md",
    "effective_condition": "human-approved merge of the charter implementation to main"
  },
  "mission": {
    "north_star": "Build and test the conditions under which artificial communities can become sustainable, top-tier organizations whose intelligence is carried not only by models, but also by persistent collective history and social evolution.",
    "program_success_conjunction": [
      "quality",
      "sustainability",
      "institutional_intelligence"
    ],
    "capability_direction": [
      "accessible",
      "composable",
      "reproducible",
      "regenerative"
    ]
  },
  "default_mode": "continue_until_constitutional_boundary",
  "operating_loop": [
    "inspect_durable_project_state",
    "select_highest_priority_unblocked_objective",
    "choose_minimum_valid_change",
    "implement",
    "test_and_run_ci",
    "fresh_exact_head_review",
    "repair_and_repeat_if_needed",
    "merge_if_autonomously_eligible_else_escalate",
    "continue"
  ],
  "work_priority": [
    "preserve_scientific_validity_provenance_security_and_history",
    "clear_blockers_on_active_authorized_work",
    "finish_or_integrate_review_clean_dependency_ready_work",
    "repair_apparatus_defects_that_can_misclassify_future_evidence",
    "implement_smallest_dependency_unlocking_next_mechanism_gate",
    "improve_reproducibility_tests_observability_and_machine_contracts",
    "open_new_research_only_with_explicit_prospective_rationale_and_boundary"
  ],
  "autonomous_actions": [
    "read_repositories_issues_prs_commits_workflows_artifacts",
    "research_relevant_external_literature",
    "create_or_update_issues_branches_prs_docs_tests_engineering_code_and_non_scientific_tooling",
    "repair_ci_and_review_defects",
    "resolve_verified_review_threads",
    "run_credential_free_tests_lint_static_analysis_and_deterministic_audits",
    "perform_fresh_exact_head_self_review",
    "preserve_negative_mixed_null_and_apparatus_failure_outcomes",
    "update_explanatory_docs_to_current_exact_state",
    "merge_only_when_autonomous_merge_policy_passes"
  ],
  "requires_human_or_separate_independent_authority": [
    "paid_provider_or_model_execution",
    "scientific_campaign_execution_authorization",
    "post_outcome_change_to_frozen_scientific_contract",
    "same_operator_proposer_and_final_acceptance_authority",
    "mechanism_registry_promotion_without_required_independent_acceptance",
    "claim_broadening_beyond_registered_evidence",
    "production_historical_substrate_activation",
    "external_publication_or_official_public_scientific_claim",
    "public_deployment_or_material_production_change",
    "purchase_billing_or_material_external_spend",
    "new_or_changed_secret_credential_or_external_permission",
    "deletion_or_rewrite_of_durable_scientific_evidence_or_authoritative_history",
    "governance_change_expanding_autonomous_authority"
  ],
  "resources": {
    "default_external_discretionary_spend_usd": 0,
    "ordinary_github_actions_ci_allowed": true,
    "credential_free_repository_compute_allowed": true,
    "provider_calls_require_explicit_authorization": true,
    "credential_persistence_allowed": false
  },
  "scientific_invariants": {
    "prospective_freeze_required": true,
    "outcome_based_confirmatory_retuning_allowed": false,
    "apparatus_failure_is_negative_mechanism_result": false,
    "independent_acceptance_required_when_governance_specifies": true,
    "claim_ceiling_required": true,
    "negative_and_mixed_results_are_first_class": true,
    "production_historical_substrate_enabled": false
  },
  "autonomous_merge_policy": {
    "allowed_scope": [
      "engineering",
      "testing",
      "maintenance",
      "explanatory_documentation"
    ],
    "forbidden_authority_mutations": [
      "frozen_scientific_contract",
      "mechanism_registry_status",
      "provider_authorization",
      "credentials",
      "deployment",
      "billing",
      "autonomous_operating_charter",
      "constitutional_governance"
    ],
    "requires_non_draft": true,
    "requires_mechanically_mergeable": true,
    "requires_intended_base": true,
    "requires_exact_head_ci": true,
    "allows_registered_expected_failure_or_skip": true,
    "requires_zero_blocking_review_threads": true,
    "requires_fresh_exact_head_review": true,
    "requires_preserved_scientific_evidence_unchanged": true,
    "requires_dependency_order_satisfied": true
  },
  "review_policy": {
    "review_attaches_to_exact_head": true,
    "head_move_invalidates_cleanliness_inference": true,
    "repair_requires_fresh_review": true,
    "self_review_substitutes_for_scientific_acceptance": false
  },
  "escalation_triggers": [
    "authoritative_governance_conflict",
    "constitutional_boundary_crossing",
    "claim_exceeds_evidence_ceiling",
    "required_independent_authority_unavailable",
    "credential_security_privacy_destructive_or_material_cost_requirement",
    "objective_still_underdetermined_after_repository_inspection",
    "continuation_requires_changing_scientific_question",
    "external_dependency_not_satisfiable_with_authorized_tools_or_permissions"
  ],
  "failure_behavior": [
    "preserve_exact_blocked_state",
    "classify_blocker",
    "do_not_fabricate_success_evidence_review_or_execution",
    "leave_recoverable_repository_state",
    "report_minimum_required_decision_or_authorization"
  ]
}
