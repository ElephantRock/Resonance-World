{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonance.world/schemas/context-graph/evidence-envelope-v0.1.json",
  "title": "Resonance World Context-Graph Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "predicate",
    "object",
    "source_id",
    "observed_by",
    "confidence",
    "direct"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_by": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "direct": {
      "type": "boolean"
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
